# kindle MCP — environment template.
#
# Copy to .env and fill in. .env is gitignored and MUST NEVER be committed:
# this is a PUBLIC repository, and .env holds a Gmail app password, a Gemini
# API key and the bearer tokens that guard the public endpoint.
#
#     cp .env.example .env && chmod 600 .env
#
# Local  (docker-compose.yml)      : .env is bind-mounted read-only at /app/.env.
# VPS    (docker-compose.vps.yml)  : .env is injected via env_file.
# Values already set in the compose files win over anything listed here, so
# only the uncommented block below is normally needed; the rest are documented
# defaults you can uncomment to tune.

# --- Kindle delivery (required) ---------------------------------------------
# All four credentials below can also be set from the web console's settings
# page, which stores them in data/settings.json (chmod 600). A value stored
# there WINS over the one here, until the field is cleared again in the console.
# Setting them here instead keeps the secrets off disk entirely.
SENDER_EMAIL=you@gmail.com                 # Gmail account that sends the EPUB; must be an Approved Sender on Amazon
GMAIL_APP_PASS=xxxxxxxxxxxxxxxx            # Google account -> Security -> App passwords (NOT your login password)
RECIPIENT_EMAIL=you@kindle.com             # Your Send-to-Kindle address (Amazon -> Manage Your Content and Devices)

# --- Gemini image generation (required for generated covers/illustrations) ---
GEMINI_API_KEY=AIza...                     # https://aistudio.google.com/apikey
#GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview  # Default image model ("pro"; "flash" = gemini-3.1-flash-image-preview)
#GEMINI_TIMEOUT_MS=300000                  # Per-generation SDK timeout in ms (a 2K Pro image can take ~40s)
#IMAGE_MAX_CONCURRENCY=3                   # Images generated in parallel per batch — bounds quota burn and 429s
#IMAGE_MAX_BATCH=12                        # Hard cap on one batch, so a confused caller can't fire 200 generations

# --- Auth, transport and public URL -----------------------------------------
# Required on the VPS (claude.ai web); leave MCP_TOKENS empty locally to disable auth.
MCP_TOKENS=                                # Comma-separated bearer tokens; empty => auth DISABLED (localhost only)
#MCP_REQUIRE_AUTH=true                     # Reject every unauthenticated request (set true on any public deployment)
#MCP_ALLOW_URL_TOKENS=true                 # Also accept ?token=... and /kindle/<token>/ — claude.ai can only pass URL tokens
#MCP_ALLOWED_HOSTS=mcp.latentstate.dev     # Extra Host values accepted by DNS-rebinding protection (comma-separated)
#MCP_PUBLIC_BASE_URL=https://mcp.latentstate.dev  # Public origin used to build download/preview links; empty => inline only
#MCP_PUBLIC_ASSET_BASE_URL=                # Override just the asset/image link prefix; empty => derived from MCP_PUBLIC_BASE_URL + MCP_NAME
#MCP_NAME=kindle                           # Service name => URL prefix /kindle/ and the MCP server name
#PORT=8018                                 # Port inside the container
#HOST=0.0.0.0                              # Bind address inside the container
#LOG_LEVEL=info                            # uvicorn log level: critical|error|warning|info|debug|trace

# --- Web console -------------------------------------------------------------
# A private, server-rendered console at /kindle/console: browse and edit books,
# rebuild the preview, manage images, send to the Kindle, edit the credentials
# above. CONSOLE_TOKEN is a SEPARATE secret from MCP_TOKENS on purpose — the
# console URL is the one you paste into a phone or leave open in a tab, and
# sharing it must never hand over the credential that can drive the MCP.
# When set, the console moves to /kindle/<CONSOLE_TOKEN>/console and the
# unprefixed path 404s. The server REFUSES TO START without one whenever
# MCP_REQUIRE_AUTH or MCP_PUBLIC_BASE_URL is set, since the console can send
# books and change credentials.
#   generate with:  openssl rand -hex 24
#CONSOLE_TOKEN=                            # empty => bare /kindle/console (localhost only)
#CONSOLE_PREVIEW_PAGES=all                 # Pages the console rasterises per build ("all", "3", "1-8"); capped by PREVIEW_MAX_PAGES
#CONSOLE_PAGE_PX=800                       # Long side of a console page proof; smaller than the MCP's inline pages, which the model reads
#CONSOLE_THUMB_PX=320                      # Long side of the cached grid thumbnails in data/.thumbs
#MAX_UPLOAD_BYTES=26214400                 # Per-file cap on a console image upload (25 MiB); rejected on Content-Length, before buffering
#SMTP_TIMEOUT_S=30                         # Per-operation Gmail SMTP timeout; a filtered port 587 would otherwise pin a job worker

# --- Storage, jobs and renderer tuning --------------------------------------
#DATA_DIR=/app/data                        # Root for books, assets and uploads; nothing is ever written outside it
#BOOK_MAX_AGE_DAYS=30                      # Book workspaces older than this are pruned by the cleanup loop
#MAX_SEND_BYTES=25165824                   # Refuse to email an EPUB larger than this (24 MiB; Gmail dies above ~25)
#JOB_MAX_WORKERS=4                         # Threads for background jobs (image batches, previews)
#MCP_SOFT_TIMEOUT_S=90                     # Wait this long inline before a slow tool hands back a job id
#JOB_TTL_S=3600                            # How long a finished job's result stays pollable

# Preview (EPUB -> PDF -> PNG)
#PREVIEW_MAX_PAGES=20                      # Max pages rasterised per preview request
#PREVIEW_TIMEOUT=180                       # Seconds before a WeasyPrint/pdftoppm run is killed
#PREVIEW_MAX_EPUB_BYTES=20971520           # Refuse to preview an EPUB bigger than this (20 MiB)
#PREVIEW_MAX_UNZIP_BYTES=268435456         # Total unzipped size cap — defuses zip bombs (256 MiB)
#PREVIEW_MAX_IMAGE_BYTES=1500000           # Per-page PNG cap handed back to the model (~1.5 MB)

# Diagram renderers
#KROKI_URL=http://kroki:8000               # Kroki sidecar used for Mermaid; unset => Mermaid unavailable
#PLANTUML_JAR=/opt/plantuml.jar            # PlantUML jar baked into the image
#DIAGRAM_TIMEOUT_S=60                      # Seconds before a diagram render is killed
#PLANTUML_TIMEOUT=60                       # Legacy fallback for DIAGRAM_TIMEOUT_S (older deployments)
#DIAGRAM_MAX_CONCURRENCY=2                 # Parallel renders; each PlantUML block costs a JVM, so keep it low on a small VPS
#GRAPHVIZ_DPI=150                          # Raster DPI for graphviz/dot output

# Math (matplotlib mathtext)
#MATH_DPI=200                              # Raster DPI for rendered formulas
#MATH_FONTSIZE=14                          # Point size formulas are rendered at
#MATH_MAX_BLOCKS=500                       # Hard cap on formulas rendered per document

# Remote image fetch
#MAX_DOWNLOAD_BYTES=26214400               # Cap on a single remote image download (25 MiB)
#MAX_DOWNLOAD_REDIRECTS=5                  # Redirect hops followed manually, so a 302 can't bypass the SSRF guard
#MAX_IMAGE_PIXELS=64000000                 # Decoded-pixel cap defusing decompression bombs
#ALLOW_PRIVATE_IMAGE_URLS=false            # Testing escape hatch: allow fetching localhost/private IPs — NEVER true in production
#FETCH_USER_AGENT=mcp-kindle/1.0 (+epub-builder)  # UA for image downloads; some CDNs 403 bare python-requests
